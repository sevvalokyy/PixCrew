# PixCrew ortam değişkenleri — ÖRNEK
#
# Bu dosyayı KOPYALAYIP adını ".env" yap, sonra kendi Supabase değerlerinle doldur.
# Gerçek .env dosyası .gitignore ile dışarıda tutulur; anahtarlar asla git'e girmez.
#
# Değerleri nereden alırsın:
#   EXPO_PUBLIC_SUPABASE_URL             → Supabase paneli → Project Settings → Data API → Project URL
#   EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY → Project Settings → API Keys → Publishable key (sb_publishable_... ile başlar)

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
